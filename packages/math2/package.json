{
  "name": "@dxyl/math2",
  "version": "1.0.18",
  "description": "math2d utils",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "graphic",
    "util",
    "2d"
  ],
  "main": "./dist/index.umd.js",
  "module": "./dist/index.js",
  "type": "module",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.umd.js"
    },
    "./math/*": {
      "types": "./types/math/*.d.ts",
      "import": "./dist/math/*.js"
    },
    "./renderer2d": {
      "types": "./types/renderer2d/index.d.ts",
      "import": "./dist/renderer2d/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "package.json",
    "readme.md",
    "dist",
    "types",
    "lib"
  ],
  "homepage": "https://github.com/dxlyf/DxMyth",
  "repository": {
    "type": "git",
    "url": "git@github.com:dxlyf/DxMyth.git"
  },
  "bugs": {
    "url": "https://github.com/dxlyf/DxMyth/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite --port=8428",
    "build": "vite build --mode esm && vite build --mode umd"
  },
  "dependencies": {
    
  }
}
