{
  "name": "@dxyl/canvaskit2",
  "version": "1.0.0",
  "description": "canvaskit graphics renderer",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "graphic",
    "util",
    "2d"
  ],
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.umd.js"
    }
  },
  "files": [
    "package.json",
    "readme.md",
    "dist",
    "types",
    "lib"
  ],
  "homepage": "https://github.com/dxlyf/DxMyth",
  "repository": {
    "type": "git",
    "url": "git@github.com:dxlyf/DxMyth.git"
  },
  "bugs": {
    "url": "https://github.com/dxlyf/DxMyth/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite --port=8428",
    "build": "vite build"
  },
  "dependencies": {
    "@types/stats.js": "^0.17.4",
    "canvaskit-wasm": "^0.41.1",
    "fast-deep-equal": "^3.1.3",
    "fast-diff": "^1.3.0",
    "gl-matrix": "^3.4.4",
    "stats.js": "^0.17.0",
    "@dxyl/math2": "workspace:*"
  }
}